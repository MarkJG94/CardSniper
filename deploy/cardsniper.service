[Unit]
Description=CardSniper MTG deal finder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cardsniper
WorkingDirectory=/opt/cardsniper
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/cardsniper/ms-playwright
ExecStart=/usr/bin/xvfb-run -a --server-args="-screen 0 1366x900x24" /opt/cardsniper/.venv/bin/cardsniper serve
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
